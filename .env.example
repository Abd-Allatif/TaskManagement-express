# Default Port
PORT=5000

# JWT Secret Key (use a long random string in real deployments)
JWT_SECRET=replace-with-a-long-random-secret

# Environment (development or production)
NODE_ENV=development

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Database Connection
DATABASE_URL=mysql://root:password@127.0.0.1:3306/task_backend_db

# Email Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM="Task Management System <no-reply@taskmanagement.com>"
